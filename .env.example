# Brevo REST API key (NOT the SMTP key — must start with xkeysib-)
# Create at: Brevo → Settings → SMTP & API → API Keys → Generate
BREVO_API_KEY=xkeysib-your-api-key-here
BOOKING_FROM_EMAIL=love2come2canada@gmail.com
BOOKING_FROM_NAME=MonBeta 预约系统
BOOKING_NOTIFY_EMAIL=love2come2canada@gmail.com

# Neon Postgres (use the pooled connection string; hostname contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# First-run admin seed (delete ADMIN_PASSWORD from Vercel after first successful login)
ADMIN_EMAIL=monbeta.dev@outlook.com
ADMIN_PASSWORD=choose-a-password-not-shared-with-outlook

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
